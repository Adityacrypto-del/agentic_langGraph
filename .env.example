# Copy to .env and fill in. Never commit .env.
# Provider: groq | gemini | ollama
LLM_PROVIDER=ollama
# Use the SAME model and temperature (0.2) on every platform.
LLM_MODEL=qwen2.5-coder:7b
GROQ_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Requests per second allowed by the client-side rate limiter
LLM_RPS=0.5
EDA_URL=http://localhost:8000
